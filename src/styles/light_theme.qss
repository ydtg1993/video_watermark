	/* =========================================================
	   浅色主题 - 专业工具风格
	========================================================= */
	* {
	    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
	    font-size: 13px;
	    outline: none;
	}
	QMainWindow,
	QWidget {
	    background: #f6f8fa;
	    color: #24292f;
	}
	/* ===== 左侧导航栏 ===== */
	QFrame#sideBar {
	    background: #ffffff;
	    border-right: 1px solid #d0d7de;
	}
	QLabel#appLogo {
	    color: #0969da;
	    padding: 10px;
	}
	QPushButton#navButton {
	    background: transparent;
	    border: none;
	    border-radius: 10px;
	    padding: 8px;
	    text-align: center;
	    color: #57606a;
	    font-size: 18px;
	}
	QPushButton#navButton:hover {
	    background: #f3f4f6;
	    color: #24292f;
	}
	QPushButton#navButton:checked {
	    background: #eef4ff;
	    color: #0969da;
	}
	QPushButton#themeButton {
	    background: #f6f8fa;
	    border: 1px solid #d0d7de;
	    border-radius: 10px;
	    color: #57606a;
	    font-size: 18px;
	}
	QPushButton#themeButton:hover {
	    background: #f3f4f6;
	    color: #24292f;
	}
	QLabel#versionLabel {
	    color: #8c959f;
	    font-size: 10px;
	}
	/* ===== 主内容区 ===== */
	QWidget#mainContent {
	    background: #f6f8fa;
	}
	/* ===== 顶部工具栏 ===== */
	QFrame#topToolbar {
	    background: #ffffff;
	    border-bottom: 1px solid #d0d7de;
	}
	QPushButton#toolbarButton {
	    background: #f6f8fa;
	    border: 1px solid #d0d7de;
	    border-radius: 10px;
	    color: #57606a;
	}
	QPushButton#toolbarButton:hover {
	    background: #f3f4f6;
	    color: #24292f;
	}
	QPushButton#startButton {
	    background: #2da44e;
	    border: none;
	    border-radius: 10px;
	    color: white;
	    font-weight: 600;
	}
	QPushButton#startButton:hover {
	    background: #2c974b;
	}
	QPushButton#startButton:disabled {
	    background: #f6f8fa;
	    color: #8c959f;
	    border: 1px solid #d0d7de;
	}
	QLabel#videoInfoLabel {
	    color: #0969da;
	    font-family: "Consolas", monospace;
	}
	QPushButton#themeToggle {
	    background: #f6f8fa;
	    border: 1px solid #d0d7de;
	    border-radius: 8px;
	    color: #57606a;
	}
	/* ===== 视频区域 ===== */
	QFrame#videoFrame {
	    background: #f6f8fa;
	}
	VideoPlayer {
	    background: #000000;
	    border: 1px solid #d0d7de;
	    border-radius: 16px;
	}
	/* ===== 控制栏 ===== */
	QFrame#controlBar {
	    background: #ffffff;
	    border: 1px solid #d0d7de;
	    border-radius: 12px;
	}
	QLabel#timeLabel,
	QLabel#totalLabel {
	    color: #0969da;
	    font-family: "Consolas", monospace;
	}
	QSlider#timelineSlider::groove:horizontal {
	    background: #d0d7de;
	    height: 6px;
	    border-radius: 3px;
	}
	QSlider#timelineSlider::handle:horizontal {
	    background: #0969da;
	    width: 16px;
	    margin: -5px 0;
	    border-radius: 8px;
	}
	QSlider#timelineSlider::sub-page:horizontal {
	    background: #0969da;
	    border-radius: 3px;
	}
	/* ===== ROI 区域面板 ===== */
	QFrame#regionPanel {
	    background: #ffffff;
	    border-top: 1px solid #d0d7de;
	}
	QLabel#panelTitle {
	    color: #24292f;
	}
	QLabel#regionHint {
	    color: #57606a;
	}
	QLabel#coordLabel {
	    color: #57606a;
	    font-size: 11px;
	}
	QSpinBox#coordSpin {
	    background: #ffffff;
	    border: 1px solid #d0d7de;
	    border-radius: 8px;
	    padding: 6px 10px;
	    color: #24292f;
	}
	QSpinBox#coordSpin:focus {
	    border: 1px solid #0969da;
	}
	QPushButton#lockButton {
	    background: #f6f8fa;
	    border: 1px solid #d0d7de;
	    border-radius: 8px;
	    color: #57606a;
	}
	QPushButton#lockButton:checked {
	    background: #0969da;
	    border: 1px solid #0969da;
	    color: white;
	}
	QPushButton#clearButton {
	    background: #f6f8fa;
	    border: 1px solid #d0d7de;
	    border-radius: 10px;
	    color: #57606a;
	}
	QPushButton#clearButton:hover {
	    background: #f3f4f6;
	    color: #24292f;
	}
	QPushButton#applyButton {
	    background: #2da44e;
	    border: none;
	    border-radius: 10px;
	    color: white;
	    font-weight: 600;
	}
	QPushButton#applyButton:hover {
	    background: #2c974b;
	}
	/* ===== 进度条 ===== */
	QFrame#progressFrame {
	    background: #ffffff;
	    border-top: 1px solid #d0d7de;
	}
	QLabel#progressLabel {
	    color: #24292f;
	}
	QProgressBar#progressBar {
	    background: #f6f8fa;
	    border: 1px solid #d0d7de;
	    border-radius: 10px;
	    text-align: center;
	    height: 20px;
	    color: #24292f;
	}
	QProgressBar#progressBar::chunk {
	    background: #2da44e;
	    border-radius: 10px;
	}
	QPushButton#cancelButton {
	    background: #cf222e;
	    border: none;
	    border-radius: 8px;
	    color: white;
	}
	QPushButton#cancelButton:hover {
	    background: #a40e26;
	}
	/* ===== 设置面板 ===== */
	QFrame#settingsPanel {
	    background: #ffffff;
	    border-left: 1px solid #d0d7de;
	}
	QGroupBox {
	    background: #ffffff;
	    border: 1px solid #d0d7de;
	    border-radius: 12px;
	    margin-top: 12px;
	    padding: 16px;
	    font-weight: 600;
	    color: #24292f;
	}
	QGroupBox::title {
	    subcontrol-origin: margin;
	    left: 16px;
	    top: -10px;
	    padding: 4px 12px;
	    background: #f6f8fa;
	    border-radius: 8px;
	    color: #0969da;
	}
	QLabel#regionLabel {
	    background: #f6f8fa;
	    padding: 8px 12px;
	    border-radius: 8px;
	    color: #0969da;
	    font-family: "Consolas", monospace;
	}
	/* ===== 输入控件 ===== */
	QLineEdit,
	QComboBox,
	QFontComboBox,
	QDoubleSpinBox {
	    background: #ffffff;
	    border: 1px solid #d0d7de;
	    border-radius: 10px;
	    padding: 10px 14px;
	    color: #24292f;
	    min-height: 24px;
	}
	QLineEdit:focus,
	QComboBox:focus,
	QFontComboBox:focus,
	QDoubleSpinBox:focus {
	    border: 1px solid #0969da;
	    background: #ffffff;
	}
	QComboBox::drop-down {
	    border: none;
	    width: 30px;
	}
	QComboBox::down-arrow {
	    border-left: 5px solid transparent;
	    border-right: 5px solid transparent;
	    border-top: 6px solid #57606a;
	    margin-right: 10px;
	}
	QComboBox QAbstractItemView {
	    background: #ffffff;
	    border: 1px solid #d0d7de;
	    border-radius: 8px;
	    selection-background-color: #eef4ff;
	}
	/* ===== 通用按钮 ===== */
	QPushButton {
	    background: #0969da;
	    border: none;
	    border-radius: 10px;
	    padding: 10px 20px;
	    color: white;
	    font-weight: 600;
	}
	QPushButton:hover {
	    background: #0c60c0;
	}
	QPushButton:pressed {
	    background: #0a58ca;
	}
	QPushButton:disabled {
	    background: #f6f8fa;
	    color: #8c959f;
	    border: 1px solid #d0d7de;
	}
	/* ===== 复选框 ===== */
	QCheckBox {
	    spacing: 10px;
	    color: #57606a;
	}
	QCheckBox::indicator {
	    width: 18px;
	    height: 18px;
	    border-radius: 4px;
	    background: #ffffff;
	    border: 1px solid #d0d7de;
	}
	QCheckBox::indicator:hover {
	    border: 1px solid #0969da;
	}
	QCheckBox::indicator:checked {
	    background: #2da44e;
	    border: 1px solid #2da44e;
	}
	/* ===== 状态栏 ===== */
	QStatusBar {
	    background: #ffffff;
	    border-top: 1px solid #d0d7de;
	    color: #57606a;
	}
	QStatusBar::item {
	    border: none;
	}
	QLabel#statusBar {
	    color: #57606a;
	    padding: 4px 10px;
	}
	QLabel#statusTime {
	    color: #0969da;
	    font-family: "Consolas", monospace;
	    padding: 4px 10px;
	}
	/* ===== 滚动条 ===== */
	QScrollBar:vertical {
	    background: transparent;
	    width: 10px;
	    margin: 4px;
	}
	QScrollBar::handle:vertical {
	    background: #d0d7de;
	    border-radius: 5px;
	    min-height: 20px;
	}
	QScrollBar::handle:vertical:hover {
	    background: #8c959f;
	}
	QScrollBar::add-line:vertical,
	QScrollBar::sub-line:vertical {
	    height: 0;
	}
	/* ===== 列表 ===== */
	QListWidget {
	    background: #ffffff;
	    border: 1px solid #d0d7de;
	    border-radius: 12px;
	    padding: 8px;
	}
	QListWidget::item {
	    padding: 12px;
	    border-radius: 8px;
	    color: #24292f;
	}
	QListWidget::item:hover {
	    background: #f6f8fa;
	}
	QListWidget::item:selected {
	    background: #0969da;
	    color: white;
	}
	/* ===== 对话框 ===== */
	QDialog {
	    background: #ffffff;
	}
	QMessageBox {
	    background: #ffffff;
	}
	/* ===== 工具提示 ===== */
	QToolTip {
	    background: #ffffff;
	    border: 1px solid #d0d7de;
	    border-radius: 8px;
	    padding: 8px 12px;
	    color: #24292f;
	}
		/* ===== GPU 监控指示器 (Light Theme) ===== */
	QFrame#gpuIndicator {
	    background: #f6f8fa;
	    border: 1px solid #d0d7de;
	    border-radius: 12px;
	    margin-right: 8px;
	    padding: 0 8px;
	}
	QLabel#gpuValue {
	    color: #1a7f37;           /* 深绿 - 对应 dark 的 #7ee787 */
	    font-family: "Consolas", monospace;
	    font-size: 11px;
	    font-weight: bold;
	}
	QLabel#encoderValue {
	    color: #0969da;           /* 深蓝 - 对应 dark 的 #79c0ff */
	    font-family: "Consolas", monospace;
	    font-size: 11px;
	}
	QLabel#tempValue {
	    color: #bf8700;           /* 深橙 - 对应 dark 的 #ffa657 */
	    font-family: "Consolas", monospace;
	    font-size: 11px;
	}