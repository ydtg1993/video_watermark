	/* =========================================================
	   深色主题 - 专业工具风格
	========================================================= */
	* {
	    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
	    font-size: 13px;
	    outline: none;
	}
	QMainWindow,
	QWidget {
	    background: #0a0e1a;
	    color: #e6edf7;
	}
	/* ===== 左侧导航栏 ===== */
	QFrame#sideBar {
	    background: #0d1117;
	    border-right: 1px solid #1c2330;
	}
	QLabel#appLogo {
	    color: #5ea2ff;
	    padding: 10px;
	}
	QPushButton#navButton {
	    background: transparent;
	    border: none;
	    border-radius: 10px;
	    padding: 8px;
	    text-align: center;
	    color: #8b949e;
	    font-size: 18px;
	}
	QPushButton#navButton:hover {
	    background: #161b22;
	    color: #e6edf7;
	}
	QPushButton#navButton:checked {
	    background: #1f2937;
	    color: #5ea2ff;
	}
	QPushButton#themeButton {
	    background: #161b22;
	    border: 1px solid #30363d;
	    border-radius: 10px;
	    color: #8b949e;
	    font-size: 18px;
	}
	QPushButton#themeButton:hover {
	    background: #21262d;
	    color: #e6edf7;
	}
	QLabel#versionLabel {
	    color: #484f58;
	    font-size: 10px;
	}
	/* ===== 主内容区 ===== */
	QWidget#mainContent {
	    background: #0a0e1a;
	}
	/* ===== 顶部工具栏 ===== */
	QFrame#topToolbar {
	    background: #0d1117;
	    border-bottom: 1px solid #1c2330;
	}
	QPushButton#toolbarButton {
	    background: #161b22;
	    border: 1px solid #30363d;
	    border-radius: 10px;
	    color: #8b949e;
	}
	QPushButton#toolbarButton:hover {
	    background: #21262d;
	    color: #e6edf7;
	}
	QPushButton#startButton {
	    background: #238636;
	    border: none;
	    border-radius: 10px;
	    color: white;
	    font-weight: 600;
	}
	QPushButton#startButton:hover {
	    background: #2ea043;
	}
	QPushButton#startButton:disabled {
	    background: #21262d;
	    color: #484f58;
	}
	QLabel#videoInfoLabel {
	    color: #5ea2ff;
	    font-family: "Consolas", monospace;
	}
	QPushButton#themeToggle {
	    background: #161b22;
	    border: 1px solid #30363d;
	    border-radius: 8px;
	    color: #8b949e;
	}
	/* ===== 视频区域 ===== */
	QFrame#videoFrame {
	    background: #0a0e1a;
	}
	VideoPlayer {
	    background: #000000;
	    border: 1px solid #30363d;
	    border-radius: 16px;
	}
	/* ===== 控制栏 ===== */
	QFrame#controlBar {
	    background: #0d1117;
	    border: 1px solid #1c2330;
	    border-radius: 12px;
	}
	QLabel#timeLabel,
	QLabel#totalLabel {
	    color: #5ea2ff;
	    font-family: "Consolas", monospace;
	}
	QSlider#timelineSlider::groove:horizontal {
	    background: #1c2330;
	    height: 6px;
	    border-radius: 3px;
	}
	QSlider#timelineSlider::handle:horizontal {
	    background: #5ea2ff;
	    width: 16px;
	    margin: -5px 0;
	    border-radius: 8px;
	}
	QSlider#timelineSlider::sub-page:horizontal {
	    background: #5ea2ff;
	    border-radius: 3px;
	}
	/* ===== ROI 区域面板 ===== */
	QFrame#regionPanel {
	    background: #0d1117;
	    border-top: 1px solid #1c2330;
	}
	QLabel#panelTitle {
	    color: #e6edf7;
	}
	QLabel#regionHint {
	    color: #8b949e;
	}
	QLabel#coordLabel {
	    color: #8b949e;
	    font-size: 11px;
	}
	QSpinBox#coordSpin {
	    background: #161b22;
	    border: 1px solid #30363d;
	    border-radius: 8px;
	    padding: 6px 10px;
	    color: #e6edf7;
	}
	QSpinBox#coordSpin:focus {
	    border: 1px solid #5ea2ff;
	}
	QPushButton#lockButton {
	    background: #161b22;
	    border: 1px solid #30363d;
	    border-radius: 8px;
	    color: #8b949e;
	}
	QPushButton#lockButton:checked {
	    background: #1f6feb;
	    border: 1px solid #1f6feb;
	    color: white;
	}
	QPushButton#clearButton {
	    background: #21262d;
	    border: 1px solid #30363d;
	    border-radius: 10px;
	    color: #8b949e;
	}
	QPushButton#clearButton:hover {
	    background: #30363d;
	    color: #e6edf7;
	}
	QPushButton#applyButton {
	    background: #238636;
	    border: none;
	    border-radius: 10px;
	    color: white;
	    font-weight: 600;
	}
	QPushButton#applyButton:hover {
	    background: #2ea043;
	}

	/* ===== 设置面板 ===== */
	QFrame#settingsPanel {
	    background: #0d1117;
	    border-left: 1px solid #1c2330;
	}
	QGroupBox {

	    border: 1px solid #30363d;
	    border-radius: 12px;
	    margin-top: 12px;
	    padding: 16px;
	    font-weight: 600;
	    color: #e6edf7;
	}
	QGroupBox::title {
	    subcontrol-origin: margin;
	    left: 16px;
	    top: -10px;
	    padding: 4px 12px;
	    border-radius: 8px;
	    color: #5ea2ff;
	}
	QLabel#regionLabel {
	    padding: 8px 12px;
	    border-radius: 8px;
	    color: #5ea2ff;
	    font-family: "Consolas", monospace;
	}
	/* ===== 输入控件 ===== */
	QLineEdit,
	QComboBox,
	QFontComboBox,
	QDoubleSpinBox {
	    background: transparent;
	    border: 1px solid #30363d;
	    border-radius: 10px;
	    padding: 10px 14px;
	    color: #e6edf7;
	    min-height: 24px;
	}
	QLineEdit:focus,
	QComboBox:focus,
	QFontComboBox:focus,
	QDoubleSpinBox:focus {
	    border: 1px solid #5ea2ff;
	    background: #1c2330;
	}
	QComboBox::drop-down {
	    border: none;
	    width: 30px;
	}
	QComboBox::down-arrow {
	    border-left: 5px solid transparent;
	    border-right: 5px solid transparent;
	    border-top: 6px solid #8b949e;
	    margin-right: 10px;
	}
	QComboBox QAbstractItemView {
	    background: #161b22;
	    border: 1px solid #30363d;
	    border-radius: 8px;
	    selection-background-color: #1f2937;
	}
	/* ===== 通用按钮 ===== */
	QPushButton {
	    background: #1f6feb;
	    border: none;
	    border-radius: 10px;
	    padding: 10px 20px;
	    color: white;
	    font-weight: 600;
	}
	QPushButton:hover {
	    background: #388bfd;
	}
	QPushButton:pressed {
	    background: #195bb5;
	}
	QPushButton:disabled {
	    background: #21262d;
	    color: #484f58;
	}
	/* ===== 复选框 ===== */
	QCheckBox {
	    spacing: 10px;
	    color: #8b949e;
	}
	QCheckBox::indicator {
	    width: 18px;
	    height: 18px;
	    border-radius: 4px;
	    background: #161b22;
	    border: 1px solid #30363d;
	}
	QCheckBox::indicator:hover {
	    border: 1px solid #5ea2ff;
	}
	QCheckBox::indicator:checked {
	    background: #238636;
	    border: 1px solid #238636;
	}
	/* ===== 状态栏 ===== */
	QStatusBar {
	    background: #0d1117;
	    border-top: 1px solid #1c2330;
	    color: #8b949e;
	}
	QStatusBar::item {
	    border: none;
	}
	QLabel#statusBar {
	    color: #8b949e;
	    padding: 4px 10px;
	}
	QLabel#statusTime {
	    color: #5ea2ff;
	    font-family: "Consolas", monospace;
	    padding: 4px 10px;
	}
	/* ===== 滚动条 ===== */
	QScrollBar:vertical {
	    background: transparent;
	    width: 10px;
	    margin: 4px;
	}
	QScrollBar::handle:vertical {
	    background: #30363d;
	    border-radius: 5px;
	    min-height: 20px;
	}
	QScrollBar::handle:vertical:hover {
	    background: #484f58;
	}
	QScrollBar::add-line:vertical,
	QScrollBar::sub-line:vertical {
	    height: 0;
	}
	/* ===== 列表 ===== */
	QListWidget {
	    background: #161b22;
	    border: 1px solid #30363d;
	    border-radius: 12px;
	    padding: 8px;
	}
	QListWidget::item {
	    padding: 12px;
	    border-radius: 8px;
	    color: #e6edf7;
	}
	QListWidget::item:hover {
	    background: #21262d;
	}
	QListWidget::item:selected {
	    background: #1f6feb;
	}
	/* ===== 对话框 ===== */
	QDialog {
	    background: #0d1117;
	}
	QMessageBox {
	    background: #0d1117;
	}
	/* ===== 工具提示 ===== */
	QToolTip {
	    background: #161b22;
	    border: 1px solid #30363d;
	    border-radius: 8px;
	    padding: 8px 12px;
	    color: #e6edf7;
	}

	/* ===== GPU 监控指示器 ===== */
	QFrame#gpuIndicator {
	    background: #161b22;
	    border: 1px solid #30363d;
	    border-radius: 12px;
	    margin-right: 8px;
	}
	QLabel#gpuValue {
	    color: #7ee787;
	    font-family: "Consolas", monospace;
	    font-size: 11px;
	    font-weight: bold;
	}
	QLabel#encoderValue {
	    color: #79c0ff;
	    font-family: "Consolas", monospace;
	    font-size: 11px;
	}
	QLabel#tempValue {
	    color: #ffa657;
	    font-family: "Consolas", monospace;
	    font-size: 11px;
	}